# Local development only. Copy to .env (gitignored): cp .env.example .env
# These are example values for the local docker compose stack. Never use them anywhere else.

# Database (OPS-14): owner role runs Flyway, app role is used by the application
POSTGRES_DB=elternstunden
POSTGRES_USER=elternstunden
POSTGRES_PASSWORD=local-dev-owner
DB_APP_PASSWORD=local-dev-app

# Host ports (bound to 127.0.0.1 only)
APP_PORT=8088
APP_MANAGEMENT_PORT=8089
DB_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
OIDC_PORT=8090

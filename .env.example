# Local development only. Copy to .env (gitignored): cp .env.example .env
# These are example values for the local docker compose stack. Never use them anywhere else.

# Database (OPS-14): owner role runs Flyway, app role is used by the application
POSTGRES_DB=elternstunden
POSTGRES_USER=elternstunden
POSTGRES_PASSWORD=local-dev-owner
DB_APP_PASSWORD=local-dev-app

# Host ports (bound to 127.0.0.1 only)
APP_PORT=8088
APP_MANAGEMENT_PORT=8089
DB_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
OIDC_PORT=8090

# Application (7.2, 9.1). Links in mails point to the Vite dev server (npm run dev).
APP_BASE_URL=http://localhost:5173
APP_ENCRYPTION_KEY=local-dev-encryption-key
ALTCHA_HMAC_KEY=local-dev-altcha-key
MAIL_FROM="Elternstunden <no-reply@elternstunden.local>"

# Master admin (7.9). Dev login: master@dev.local, password local-dev-master, TOTP from the secret below
# (add it to an authenticator app or run: oathtool --totp -b <secret>). The hash is Argon2id; keep the single
# quotes, otherwise docker compose would read the $ signs as variables.
MASTER_ADMIN_EMAIL=master@dev.local
MASTER_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$rsG5rydiKoWECh5E3lfGjg$pCWv+QFg/AmD1NdgvYcNzdWVA2TPjMxkP5KZ0fW/py0'
MASTER_ADMIN_TOTP_SECRET=D34POOYQAW2UOZDTBECYZUZLSKKYSMTT

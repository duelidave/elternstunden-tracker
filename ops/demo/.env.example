# Demo stack behind an existing Traefik. Copy to .env (gitignored): cp .env.example .env
# Replace every CHANGE_ME. Secrets belong only into .env on the server, never into the repository.

# Public address (APP_BASE_URL is the only source for links in mails, SEC-17)
APP_DOMAIN=elternstunden.hort-an-der-montessorischule.de
APP_BASE_URL=https://elternstunden.hort-an-der-montessorischule.de

# Existing Traefik: Docker network it reaches containers through, entrypoint (HTTPS) and certificate resolver
TRAEFIK_NETWORK=CHANGE_ME
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=CHANGE_ME
# Regex for the address Traefik connects from (SEC-04). Use the exact container address if you can, for example
# 172\.18\.0\.2, or the subnet of the Traefik network: docker network inspect <network>
TRUSTED_PROXY_REGEX=CHANGE_ME

# Database (OPS-14): owner role runs Flyway, app role is used by the application. openssl rand -base64 24
POSTGRES_DB=elternstunden
POSTGRES_USER=elternstunden
POSTGRES_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME

# At least 32 random characters each, the app does not start in production otherwise. openssl rand -base64 48
APP_ENCRYPTION_KEY=CHANGE_ME
ALTCHA_HMAC_KEY=CHANGE_ME

# Mail goes to Mailpit, nobody receives it. Read it over an SSH tunnel: ssh -L 8025:localhost:8025 <server>
MAIL_FROM="Elternstunden <no-reply@elternstunden.hort-an-der-montessorischule.de>"
MAILPIT_UI_PORT=8025

# Master admin (7.9): the only account with a password. Argon2id hash with at least m=19456,t=2,p=1 (see README),
# keep the single quotes, otherwise docker compose would read the $ signs as variables. TOTP secret is base32.
MASTER_ADMIN_EMAIL=CHANGE_ME
MASTER_ADMIN_PASSWORD_HASH='CHANGE_ME'
MASTER_ADMIN_TOTP_SECRET=CHANGE_ME

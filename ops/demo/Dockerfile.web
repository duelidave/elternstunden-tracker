# syntax=docker/dockerfile:1
# Demo web image: the built SPA behind nginx. Build context is the repository root, because the build reads
# api/openapi.yaml (generated client, D-25) and VERSION (D-32). Production images follow with M7.

FROM node:24-alpine AS build
WORKDIR /workspace
COPY VERSION VERSION
COPY api api
COPY frontend/package.json frontend/package-lock.json frontend/
RUN --mount=type=cache,target=/root/.npm npm --prefix frontend ci
COPY frontend frontend
# Fails if the dev toolbar ended up in the bundle (AC-DEV-03)
RUN npm --prefix frontend run build

FROM nginx:1.29.8-alpine
COPY ops/demo/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/frontend/dist /usr/share/nginx/html
EXPOSE 80
